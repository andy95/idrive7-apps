{
  "id": "xtraboost_guard",
  "title": "XtraBoost Guard",
  "description": "Gotowosc bojowa 420 KM, ochrona zimnego B48 i licznik serwisu PHEV dla BMW G30 530e Stage 1",
  "version": "1.0.0",
  "vendor": "custom",
  "loggingId": "OA9E",
  "iconGlyph": "gauge",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusBattery2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusVehiclePartType": "rs",
      "highVoltageStorageInfoToExternal": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "statusDisplayElectricalPowerDistribution": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "statusBatteryTemperature": "rs"
    },
    "de.bmw.infotainment.lsc.LSCDataSink": {
      "statusHighVoltageStorage": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "XtraBoost Guard",
      "buttons": [
        ["BTN_ACTION", "Reset Peak"],
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        ["m_tricolour", "M Tricolour"],
        ["m_red", "M Red"],
        ["ice", "Ice White"],
        ["amber", "Night Amber"]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        ["full", "Full screen"],
        ["standard", "Standard"]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        ["auto", "GPU 60 fps (default)"],
        ["software", "Software"]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        ["auto", "Auto"],
        ["on", "Always"],
        ["off", "Never"]
      ]
    },
    {
      "key": "cooldownSec",
      "label": "Turbo cool-down duration",
      "type": "number",
      "unit": "s",
      "default": 90,
      "steps": [30, 45, 60, 90, 120, 150, 180]
    },
    {
      "key": "warmOil",
      "label": "Oil is warm at",
      "type": "number",
      "unit": "°C",
      "default": 80,
      "steps": [60, 70, 75, 80, 85, 90]
    },
    {
      "key": "targetBoost",
      "label": "Stage 1 Target Boost",
      "type": "number",
      "unit": "bar",
      "default": 1.5,
      "steps": [1.0, 1.2, 1.3, 1.4, 1.5, 1.6, 1.7, 1.8]
    },
    {
      "key": "knockThreshold",
      "label": "Knock Retard Alert Threshold",
      "type": "number",
      "unit": "°",
      "default": -3.0,
      "steps": [-1.5, -2.0, -2.5, -3.0, -3.5, -4.0]
    }
  ]
}
